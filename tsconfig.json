{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "lib": ["ES2022"],
    "moduleResolution": "node"
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "jest.config.ts"]
} 